{
  "caption": "Physical Security",
  "category": "physical_security",
  "description": "Physical Security events report activity in the physical world. This is the base event class from which all Physical Security classes derive; it is not used directly.",
  "extends": "base_event",
  "name": "physical_security",
  "profiles": [
    "physical_site"
  ],
  "attributes": {
    "$include": [
      "profiles/physical_site.json"
    ],
    "lifecycle_id": {
      "group": "classification",
      "requirement": "recommended"
    },
    "lifecycle": {
      "requirement": "optional"
    },
    "signal_code": {
      "group": "context",
      "requirement": "recommended"
    },
    "derivation_id": {
      "group": "classification",
      "requirement": "recommended"
    },
    "derivation": {
      "requirement": "optional"
    },
    "confidence_pct": {
      "requirement": "optional"
    },
    "urgency_id": {
      "requirement": "optional"
    },
    "urgency": {
      "requirement": "optional"
    },
    "certainty_id": {
      "requirement": "optional"
    },
    "certainty": {
      "requirement": "optional"
    },
    "response_type_id": {
      "requirement": "optional"
    },
    "response_type": {
      "requirement": "optional"
    },
    "location": {
      "group": "context",
      "requirement": "recommended"
    },
    "device": {
      "group": "context",
      "requirement": "optional",
      "profile": null
    },
    "actor": {
      "group": "context",
      "requirement": "optional",
      "profile": null
    }
  }
